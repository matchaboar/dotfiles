prompt-length() {
  emulate -L zsh -o extendedglob
  local str="$1" cols=${2:-$COLUMNS}

  # Expand prompt escapes first (%F, %B, etc.)
  str=${(%):-$str}

  # Remove ANSI CSI (ESC [ ...), OSC (ESC ] ... BEL/ESC \), and DCS (ESC P ... ESC \)
  str=${str//$'\e'(\[[0-9;]#[@-~]|\][^\a\\]#(\a|\\)|P[^\a\\]#\\)/}

  echo ${#str}
}


