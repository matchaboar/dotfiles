# Lazy-load nvm in interactive shells (eager-loaded in ~/.zprofile for non-interactive/MCP).
# This saves ~500ms on shell startup; nvm/node/npm/npx load on first use.
export NVM_DIR="$HOME/.nvm"
_nvm_lazy_load() {
  unset -f nvm node npm npx 2>/dev/null
  [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
  [ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"
}
nvm()  { _nvm_lazy_load; nvm  "$@"; }
node() { _nvm_lazy_load; node "$@"; }
npm()  { _nvm_lazy_load; npm  "$@"; }
npx()  { _nvm_lazy_load; npx  "$@"; }


. "$HOME/.local/bin/env"

# Path to Windows Git (for adding safe.directory entries visible to Windows tools)
GIT_WINDOWS="/mnt/c/Program Files/Git/cmd/git.exe"

# Mark a repo as safe for Windows Git, with a colored confirmation prompt.
safe_win() {
  local repo="$1"
  if [[ -z "$repo" ]]; then
    echo "Usage: safe_win /path/to/repo"
    return 1
  fi

  local win_path
  win_path="$(wslpath -w -a "$repo")"

  # Check if already marked safe
  if "$GIT_WINDOWS" config --global --get-all safe.directory 2>/dev/null | grep -Fxq "$win_path"; then
    print -r -- "✔ Already safe in Windows Git: $win_path"
    return 0
  fi

  # ncurses-style box with pink background and proper width
  local bold reset fg_grey bg_pink
  bold="$(tput bold 2>/dev/null || echo $'\e[1m')"
  reset="$(tput sgr0 2>/dev/null || echo $'\e[0m')"
  fg_grey="$(tput setaf 7 2>/dev/null || echo $'\e[37m')"
  bg_pink="$(tput setab 5 2>/dev/null || echo $'\e[45m')"

  local title="${fg_grey}${bold}Mark as safe.directory for Windows Git?"
  local buttons="[Y] yes     [N] no"
  local pad=2

  local max_len=$(prompt-length "$title")
  # $title = "${fg_grey}${bold}Mark as safe.directory for Windows Git?${reset}"
  local tlen=$(prompt-length "$win_path"); (( tlen > max_len )) && max_len=$tlen
  tlen=$(prompt-length "$buttons"); (( tlen > max_len )) && max_len=$tlen

  local content_width=$(($max_len + pad))
  local border
  border=$(printf '%*s' "$content_width" '' | tr ' ' '-')

  _line() {
    local text="$1"
    # inner width accounts for the leading/trailing space in the format string
    local inner=$((content_width - 2))
    local vislen=$(prompt-length "$text")
    if (( vislen > inner )); then
      text="${text:0:$inner}"
      vislen=$inner
    fi
    local pad_spaces=$((inner - vislen))
    # print text (may contain color codes) then pad separately so ANSI bytes don't skew width
    printf "%s│ %s%s%*s │%s\n" "$bg_pink$bold" "$text" "$reset$bg_pink$bold" $pad_spaces "" "$reset"
  }

  printf "%s┌%s┐%s\n" "$bg_pink$bold" "$border" "$reset"
  _line "$title"
  _line "$win_path"
  _line "$buttons"
  printf "%s└%s┘%s\n" "$bg_pink$bold" "$border" "$reset"
  printf "> "
  read -r reply
  if [[ "$reply" =~ ^[Yy]$ ]]; then
    "$GIT_WINDOWS" config --global --add safe.directory "$win_path" && \
      print -r -- "${green}Added safe.directory:${reset} $win_path"
  else
    print -r -- "${red}Skipped.${reset}"
  fi
}
# fix unc paths not supported with cmd
fork() {
  local target="${1:-.}"
  local abs_path; abs_path="$(realpath "$target")"
  safe_win "$abs_path"

  local win_path; win_path="$(wslpath -w -a "$abs_path")"
  # Launch Fork via PowerShell with a drive-backed working directory (avoids UNC warnings)
  /mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe \
    -NoLogo -NoProfile -Command "Set-Location \$env:SystemDrive; \$fork=\"\$env:LOCALAPPDATA\\Fork\\current\\Fork.exe\"; & \$fork \"${win_path}\""
}

